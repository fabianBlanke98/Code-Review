# Copy to .env and fill in as you work through SETUP.md.
# `npm run check` reads this file. It is gitignored — keep it that way, every
# value below is a credential.

# --- step 1: database ------------------------------------------------------
# Supabase → Project settings → Database → Connection string → URI.
# Use the DIRECT connection, not the pooled one: the worker claims jobs with
# SELECT ... FOR UPDATE SKIP LOCKED and needs a session it owns.
DATABASE_URL=

# --- step 2: object storage ------------------------------------------------
# Cloudflare → R2 → Manage API tokens. Scope the token to this one bucket,
# Object Read & Write. Choose the EU jurisdiction when creating the bucket.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mosaic
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- step 3: edge functions ------------------------------------------------
# Supabase → Project settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
