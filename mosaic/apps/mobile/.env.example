# Copy to .env. Everything here is public by design — EXPO_PUBLIC_* variables
# are compiled into the app bundle, so nothing secret may go in this file.
# The anon key is safe to ship: RLS is what protects the data, not the key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Origin used to build invite links.
EXPO_PUBLIC_WEB_ORIGIN=https://mosaic.app

# Needed for push tokens on EAS builds.
EXPO_PUBLIC_EAS_PROJECT_ID=
