# Local worker runs only. In production these are `fly secrets set`, never a
# file — a secret in the image is a secret in the registry.

DATABASE_URL=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mosaic
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional
POLL_INTERVAL_MS=2000
MAX_ATTEMPTS=5
PUSH_COOLDOWN_MINUTES=60
